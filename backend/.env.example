NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

LIVEBLOCK_API_KEY=
LIVEBLOCK_SECRET_KEY=
NEXT_PUBLIC_LIVEBLOCKS_PUBLIC_KEY=

DATABASE_URL=
DIRECT_URL=
REDIS_URL=

# Email Option 1: Gmail App Password via Nodemailer (Recommended for sending to any email)
GMAIL_USER="your-email@gmail.com"
GMAIL_APP_PASSWORD="your-16-character-app-password"
SMTP_FROM="Hanoi AI <your-email@gmail.com>"

# Email Option 2: Custom SMTP Server
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false

# Email Option 3: Resend API (Sandbox only sends to account owner email unless custom domain verified)
RESEND_API_KEY=
RESEND_FROM_EMAIL="onboarding@resend.dev"

SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_BUCKET=attachments

JWT_SECRET=""
JWT_ALG=""

FRONTEND_URL="http://localhost:3000"
BACKEND_PORT=8000

# OpenAI AI Agent Configuration
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"

# MongoDB Database Configuration (for storing AI chat messages & outputs)
MONGODB_URI="mongodb+srv://<username>:<password>@cluster.mongodb.net/hanoi_ai?retryWrites=true&w=majority"
MONGODB_DB_NAME="hanoi_ai"
